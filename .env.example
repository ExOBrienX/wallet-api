# Copiar a .env y completar. El .env nunca se commitea.
# Lo leen tanto Docker Compose como la API en el perfil dev.

# Base de datos
DB_NAME=wallet
DB_USERNAME=wallet
DB_PASSWORD=wallet
DB_PORT=5433

# Clave para firmar los JWT (mínimo 32 caracteres). Para generar una:
#   openssl rand -base64 48
JWT_SECRET=

# Administrador inicial (opcional). Se crea al arrancar si ambos valores están definidos.
WALLET_ADMIN_EMAIL=
WALLET_ADMIN_PASSWORD=
